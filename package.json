{
  "name": "tidekeeper",
  "version": "0.1.0",
  "description": "A version-control-first CLI for synchronizing and searching a TIDAL library.",
  "type": "module",
  "bin": {
    "tidekeeper": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@tidal-music/api": "^0.34.0",
    "@tidal-music/auth": "^1.6.1",
    "@tidal-music/common": "^0.2.1",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
